# Docker Compose runs Moto locally and does not require this file.
# These values are for running against AWS or another S3-compatible service.
PORT="8000"
AWS_DEFAULT_REGION="eu-central-1"
AWS_ACCESS_KEY_ID="AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="AWS_SECRET_ACCESS_KEY"
AWS_ENDPOINT_URL=""
S3_BUCKET="S3_BUCKET"
S3_TEST_BUCKET="S3_TEST_BUCKET"